{
  "name": "glaude-vibe-coder",
  "version": "1.0.2",
  "description": "Terminal-first AI coding assistant with CLI and desktop runtime components.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "宫丰霖 <gongfenglin@sdust.edu.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2830500285/glaude-vibe-coder.git"
  },
  "homepage": "https://github.com/2830500285/glaude-vibe-coder#readme",
  "bugs": {
    "url": "https://github.com/2830500285/glaude-vibe-coder/issues"
  },
  "keywords": [
    "claude",
    "anthropic",
    "cli",
    "ai",
    "coding-assistant",
    "terminal",
    "repl"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "claude-js": "dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "packages/@ant/*"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run src/entrypoints/cli.tsx",
    "app": "bun run app/server.ts",
    "app:no-open": "bun run app/server.ts --no-open",
    "desktop:bundle": "node scripts/build-desktop-bundle.mjs",
    "desktop:dev": "node desktop-builder/node_modules/electron/cli.js .",
    "desktop:dist": "node scripts/build-desktop-bundle.mjs && node desktop-builder/node_modules/electron-builder/cli.js --win nsis",
    "desktop:dir": "node scripts/build-desktop-bundle.mjs && node desktop-builder/node_modules/electron-builder/cli.js --win dir",
    "prepublishOnly": "bun run build",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --fix src/",
    "format": "biome format --write src/",
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test",
    "check:unused": "knip-bun",
    "health": "bun run scripts/health-check.ts",
    "docs:dev": "npx mintlify dev"
  },
  "dependencies": {},
  "build": {
    "appId": "com.sdust.glaudevibecoder",
    "productName": "Glaude Vibe Coder",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/desktop-runtime",
        "to": "desktop-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glaude Vibe Coder"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "knip": "^5.63.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
